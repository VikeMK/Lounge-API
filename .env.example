# Copy to .env and fill in.
# SQL Server needs 8+ chars with upper, lower, digit and symbol.
# Avoid ; and " in it (it goes inside a connection string).
SA_PASSWORD=Change_me_123!

ASPNETCORE_ENVIRONMENT=Development
# Dev-only extra services (CloudBeaver DB UI, s3mock for table images). Leave empty in production.
COMPOSE_PROFILES=development

# Basic-auth creds for the write endpoints (defaults to admin/admin if unset)
API_USERNAME=admin
API_PASSWORD=admin
API_PASSWORD_SECONDARY=admin2

# ---- Production server only (uncomment on the server) ----
# Use the production overrides (Cloudflare Tunnel, no published ports, SQL Server Express)
# COMPOSE_FILE=compose.yaml:compose.prod.yaml
# Token from Cloudflare Zero Trust > Networks > Tunnels > your tunnel. Treat it like a password.
# CLOUDFLARE_TUNNEL_TOKEN=
# SQL Server edition: Express (free, 10 GB per database) or a paid edition you're licensed for
# MSSQL_PID=Express
# Table images in Cloudflare R2 (required in production; locally the s3mock defaults are used).
# R2 > Manage API tokens: Object Read & Write, limited to the table images AND backups buckets.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lounge-table-images
# Public custom domain connected to the bucket (where /TableImage redirects to)
# TABLE_IMAGE_BASE_URL=https://images.example.com
# Purges an image from Cloudflare's cache when it's re-uploaded (required in production).
# Zone ID: your zone's overview page, right-hand sidebar. Token: My Profile > API Tokens,
# custom token with Zone > Cache Purge > Purge on that zone.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_PURGE_TOKEN=
# Database backups to a separate, private R2 bucket (deploy/backup-db.sh), using the R2 token above.
# BACKUP_R2_BUCKET=lounge-db-backups
# How long to keep backups in the bucket (rclone duration, e.g. 14d, 30d, 90d)
# BACKUP_RETENTION=30d
